{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Go棋譜Studio",
  "version": "0.8.0-preview.1",
  "identifier": "jp.h-eba.kifu-editor",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Go棋譜Studio",
        "width": 1280,
        "height": 900,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true,
        "dragDropEnabled": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
