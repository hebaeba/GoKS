{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GoKifuStudio",
  "version": "0.7.0",
  "identifier": "jp.h-eba.kifu-editor",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GoKifuStudio",
        "width": 1280,
        "height": 900,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
